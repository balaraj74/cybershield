# CyberShield AI - Endpoint Agent Configuration
# Copy this file to .env and modify as needed

# Backend connection
CYBERSHIELD_BACKEND_URL=http://localhost:8001
CYBERSHIELD_API_KEY=cybershield-api-key

# Monitoring intervals (seconds)
SCAN_INTERVAL=10
REPORT_INTERVAL=30
COMMAND_POLL_INTERVAL=15

# Directories to watch (JSON array)
# WATCH_DIRECTORIES=["C:\\Users\\YourUser\\Documents","C:\\Users\\YourUser\\Desktop"]

# Thresholds
CPU_THRESHOLD=80.0
MEMORY_THRESHOLD=500.0
NET_CONNECTIONS_THRESHOLD=50
FILE_OPS_THRESHOLD=100

# Auto Response
AUTO_KILL_ENABLED=true
AUTO_KILL_THRESHOLD=0.85

# Logging
LOG_LEVEL=INFO
